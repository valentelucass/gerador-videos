# SynthReel generated workspace
workspace/temp/
workspace/output/
workspace/cache/
workspace/downloads/
workspace/lotes_preparados/
workspace/lotes_horizontais/

# Persistent local media banks: keep folders/docs, ignore heavy/private media
workspace/assets/background_music/*
!workspace/assets/background_music/.gitkeep
workspace/assets/transitions/*
!workspace/assets/transitions/.gitkeep
workspace/voice_refs/*
!workspace/voice_refs/.gitkeep
!workspace/assets/README.md

# Horizontal assets
workspace/assets/horizontal/trilhas/*
!workspace/assets/horizontal/trilhas/.gitkeep
workspace/assets/horizontal/overlays/*
!workspace/assets/horizontal/overlays/.gitkeep
workspace/assets/horizontal/fundos_estaticos/*
!workspace/assets/horizontal/fundos_estaticos/.gitkeep

# User inputs
entradas/
entradas_lotes/

