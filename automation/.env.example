# URL da plataforma beta. Obrigatória.
PLATFORM_URL=https://example.com
# Opcional: URL de um projeto/tela Vibes já preparado para retomar animações.
# O botão normal "Animar IA" sempre ignora esta URL e começa um projeto novo.
# Use somente "Retomar Vibes" no painel quando quiser reutilizá-la de propósito.
RESUME_URL=
BROWSER=firefox
HEADLESS=false
# dark força o tema da página e do Firefox dedicado da automação.
BROWSER_COLOR_SCHEME=dark
SHOW_CLICK_HIGHLIGHT=true
CLICK_HIGHLIGHT_DURATION_MS=550
MAX_UPLOAD=12
DEFAULT_TIMEOUT_MS=30000
RETRY_INITIAL_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=30
RATE_LIMIT_WAIT_SECONDS=300
ERROR_RETRY_DELAY_SECONDS=5
# Evita martelar a mesma geração quando o Vibes está saturado. Depois de N
# erros consecutivos da mesma foto, o robô aguarda este tempo antes de repetir.
REPEATED_ERROR_THRESHOLD=3
REPEATED_ERROR_WAIT_SECONDS=300
# Na 5ª falha, a mídia é adiada para uma rodada exclusiva.
MAX_GENERATION_ERRORS_PER_ROUND=5
# Pausa entre rodadas compostas somente de mídias adiadas.
DEFERRED_ROUND_WAIT_SECONDS=60
# Quantidade máxima de rodadas compostas somente por fotos adiadas.
MAX_DEFERRED_ROUNDS=3
# Impede um botão travado de manter uma mídia em retry infinito.
IMAGE_STEP_TIMEOUT_SECONDS=90
# Tempo de espera antes de atualizar uma tela fatal "Something went wrong".
PLATFORM_ERROR_REFRESH_DELAY_SECONDS=5
# Tempo máximo para o toast confirmar o upload após clicar em Carregar/Upload.
UPLOAD_RESULT_TIMEOUT_SECONDS=60
RESULT_TIMEOUT_SECONDS=900
# Ajuste quando a UI não expuser o nome do arquivo no card.
IMAGE_CARD_SELECTOR=
# Para reutilizar uma sessão do Firefox, informe o diretório do perfil. A
# automação cria uma cópia de trabalho e não interfere no Firefox aberto.
FIREFOX_PROFILE_DIR=
FIREFOX_EXECUTABLE_PATH=

# Google Flow — automação independente da esteira Vibes.
# Padrão: Chrome com depuração remota. O painel abre a página inicial do Flow
# em um perfil dedicado; escolha manualmente o projeto/chat antes de ativar.
# Use FLOW_BROWSER=firefox apenas se preferir a cópia persistente do perfil Firefox.
FLOW_BROWSER=chromium
FLOW_CDP_URL=http://127.0.0.1:9222
FLOW_PAGE_URL_CONTAINS=labs.google/fx/
# O painel define esta opção automaticamente com o link exato informado antes do início.
FLOW_PAGE_URL_EXACT=false
FLOW_TIMEOUT_MS=30000
FLOW_RESULT_TIMEOUT_SECONDS=900
FLOW_RETRY_DELAY_SECONDS=12
FLOW_MAX_ATTEMPTS_PER_ITEM=3
FLOW_CARD_SELECTOR=[data-testid*='asset']
FLOW_CARD_ID_ATTRIBUTE=data-id
FLOW_CHAT_SELECTOR=[role='textbox'][data-slate-editor='true'][contenteditable='true']
FLOW_SEND_SELECTOR=button:has(i:text-is('arrow_forward'))
FLOW_ANIMATE_SELECTOR=button:has-text('Animate')
FLOW_ANIMATION_PROMPT_SELECTOR=textarea
FLOW_ANIMATION_SEND_SELECTOR=button[aria-label*='Generate']
FLOW_DOWNLOAD_SELECTOR=button[aria-label*='Download']
FLOW_DELETE_SELECTOR=button[aria-label*='Delete']
FLOW_CONFIRM_DELETE_SELECTOR=button:has-text('Delete')
FLOW_ERROR_SELECTOR=text=/generation failed|falha ao gerar/i
